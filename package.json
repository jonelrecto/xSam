{
  "name": "xsam-sepe",
  "version": "1.0.0",
  "description": "Secure Exam & Proctoring Environment (SEPE / XSAM)",
  "main": "dist/server.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@xsam/web",
    "dev:server": "npm run dev --workspace=@xsam/server",
    "dev:web": "npm run dev --workspace=@xsam/web",
    "dev:all": "npm run dev --workspaces --if-present",
    "build:packages": "npm run build --workspace=@xsam/shared && npm run build --workspace=@xsam/db",
    "build:server": "npm run build --workspace=@xsam/server",
    "build:web": "npm run build --workspace=@xsam/web",
    "build": "npm run build:packages && npm run build:server && npm run build:web",
    "next:dev": "next dev",
    "next:build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate --workspace=@xsam/db",
    "db:push": "npm run db:push --workspace=@xsam/db",
    "db:seed": "tsx -r dotenv/config src/scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^8.1.0",
    "@fastify/static": "^6.12.0",
    "@fastify/websocket": "^8.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.1.20",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.8.0",
    "nanoid": "^3.3.7",
    "next": "^15.2.0",
    "papaparse": "^5.5.2",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "resend": "^4.1.2",
    "sharp": "^0.33.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.3.15",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}